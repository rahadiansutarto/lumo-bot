# ==========================================
# SLACK CONFIGURATION
# ==========================================
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# ==========================================
# ANTHROPIC/CLAUDE CONFIGURATION
# ==========================================
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_RESOURCE=your-resource-name

# ==========================================
# ATTIO CRM CONFIGURATION
# ==========================================
ATTIO_API_KEY=your-attio-api-key

# ==========================================
# POSTGRESQL DATABASE CONFIGURATION
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leave_management
DB_USER=postgres
DB_PASSWORD=your-database-password

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# MANAGER SLACK IDs (for leave approvals)
# ==========================================
AXEL_SLACK_ID=U123456789
NADIA_SLACK_ID=U987654321

# ==========================================
# LEADERSHIP SLACK IDs (for weekly reports)
# ==========================================
GURNOOR_SLACK_ID=U111111111
SANDEEP_SLACK_ID=U222222222
EMEKA_SLACK_ID=U333333333

# ==========================================
# GOOGLE SHEETS CONFIGURATION
# ==========================================
# Service account JSON key (as a single-line string)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Weekly Check-Ins Google Sheets
WEEKLY_CHECKINS_SPREADSHEET_ID=your-spreadsheet-id
WEEKLY_CHECKINS_ROSTER_TAB=Roster
WEEKLY_CHECKINS_WORKER_TAB=Worker Responses
WEEKLY_CHECKINS_MANAGER_TAB=Manager Responses

# Google Forms URLs
WORKER_CHECKIN_FORM_URL=https://docs.google.com/forms/d/e/your-worker-form-id/viewform
MANAGER_REVIEW_FORM_URL=https://docs.google.com/forms/d/e/your-manager-form-id/viewform

# ==========================================
# OPTIONAL CONFIGURATIONS
# ==========================================
WEATHER_API_KEY=your-weather-api-key
NODE_ENV=development
LOG_LEVEL=info
