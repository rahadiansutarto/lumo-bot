# Slack Bot Configuration
SLACK_BOT_TOKEN=your-token-here
SLACK_APP_TOKEN=your-token-here

# Azure Foundry Configuration
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_RESOURCE=your-key-here

# Weather App
WEATHER_API_KEY=your-key-here

# Attio CRM Configuration
ATTIO_API_KEY=your-key-here
ATTIO_BASE_URL=https://api.attio.com/v2
ATTIO_WORKSPACE_ID=your-key-here
ATTIO_ENABLED=true

# Google Calendar OAuth
GOOGLE_CLIENT_ID=paste_your_client_id_here
GOOGLE_CLIENT_SECRET=paste_your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Company Email Restriction (IMPORTANT!)
COMPANY_EMAIL_DOMAIN=yourcompany.com